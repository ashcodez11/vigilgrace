# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# private/local configuration — never commit real contact numbers or secrets
config/local.config.json
backend/server/.env
backend/server/data/
backend/server/node_modules/

# local evidence recordings (never commit)
# Allow src/core/evidence/ source code, but block data directories
/evidence/
backend/server/evidence/

# AI evaluation harness: model binary, downloaded audio and local venv stay out.
# The harness itself (evaluation/*.py, requirements, NOTICE, results) is tracked.
evaluation/data/
evaluation/models/
evaluation/venv/
__pycache__/
